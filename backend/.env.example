# ==========================================
# SafeHer — Environment Variables Template
# Copy this file to .env and fill in your values
# ==========================================

# Django Core
SECRET_KEY=django-insecure-change-this-in-production-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,*

# Database Configuration (leave empty for SQLite, or configure PostgreSQL)
DB_ENGINE=sqlite
DB_NAME=women_safety_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# CORS & Security
CORS_ALLOW_ALL_ORIGINS=True

# JWT Token Lifetime
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Settings (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_google_app_password
DEFAULT_FROM_EMAIL=SafeHer Emergency <your_email@gmail.com>

# SMS Gateway (Fast2SMS for India)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
