<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A"
    android:keepScreenOn="true">

    <!-- Top Caller Details -->
    <LinearLayout
        android:id="@+id/layoutCallerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="64dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Avatar Ring -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_sos_ring_outer"
            android:backgroundTint="#3329B6F6">

            <ImageView
                android:id="@+id/ivCallerAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/neon_cyan" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-bold"
            android:text="Mom ❤️"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Incoming Call..."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Connected In-Call Buttons (Visible after accept) -->
    <LinearLayout
        android:id="@+id/layoutInCallControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnEndCall"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_dark_card"
            android:padding="12dp"
            android:src="@drawable/ic_gear_neon"
            app:tint="@color/white" />

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_dark_card"
            android:padding="12dp"
            android:src="@drawable/ic_police_neon"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Connected End Call Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnEndCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="60dp"
        android:contentDescription="End Call"
        android:src="@drawable/ic_cancel_neon"
        android:visibility="gone"
        app:backgroundTint="#FF1744"
        app:fabSize="normal"
        app:tint="@color/white" />

    <!-- Incoming Call Slider/Buttons (Decline and Accept) -->
    <RelativeLayout
        android:id="@+id/layoutIncomingControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="60dp"
        android:paddingHorizontal="48dp">

        <!-- Decline Call (Red) -->
        <LinearLayout
            android:id="@+id/btnDeclineCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:src="@drawable/ic_cancel_neon"
                app:backgroundTint="#FF1744"
                app:elevation="4dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Decline"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Accept Call (Green) -->
        <LinearLayout
            android:id="@+id/btnAcceptCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:src="@drawable/ic_call"
                app:backgroundTint="#00E676"
                app:elevation="4dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Accept"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
