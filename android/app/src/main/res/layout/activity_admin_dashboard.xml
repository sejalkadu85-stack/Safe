<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- ==============================================
                 TOP HEADER (SafeHer Admin Panel)
            ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Shield Logo -->
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_safeher_logo"
                    android:contentDescription="Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SafeHer Admin Panel"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monitor · Respond · Keep Communities Safe"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Switch to User View Pill -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchToUserView"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="User View"
                    android:textSize="11sp"
                    android:textColor="@color/neon_cyan"
                    app:strokeColor="@color/neon_cyan"
                    app:strokeWidth="1dp"
                    app:cornerRadius="18dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp" />

                <!-- Language Switcher Icon -->
                <ImageView
                    android:id="@+id/btnAdminLanguage"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_dark_card"
                    android:padding="7dp"
                    android:src="@drawable/ic_language"
                    app:tint="@color/neon_cyan"
                    android:contentDescription="Language"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Logout Icon -->
                <ImageButton
                    android:id="@+id/btnAdminLogout"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_dark_card"
                    android:src="@drawable/ic_cancel_neon"
                    android:contentDescription="Logout"
                    app:tint="@color/sos_red" />
            </LinearLayout>

            <!-- Admin Banner Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dark_card"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot_active"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvAdminWelcome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="System Administrator: Live Incident Triage Active"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEscalationSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="⏱️ Escalation"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:backgroundTint="#13233E"
                    app:strokeColor="@color/neon_pink"
                    app:strokeWidth="1dp"
                    app:cornerRadius="16dp"
                    android:paddingHorizontal="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenWebConsole"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🌐 Web"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:backgroundTint="#13233E"
                    app:strokeColor="@color/neon_cyan"
                    app:strokeWidth="1dp"
                    app:cornerRadius="16dp"
                    android:paddingHorizontal="8dp" />

            </LinearLayout>

            <!-- ==============================================
                 ROW 1: 4 GLOWING STAT CARDS (2x2 Grid)
            ============================================== -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="20dp">

                <!-- 1. Total Users -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_dark_card"
                    android:padding="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Users"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvStatTotalUsers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvStatTotalUsersSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verified accounts"
                        android:textColor="@color/neon_cyan"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 2. Active Alerts -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_dark_card"
                    android:padding="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Alerts"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvStatActiveAlerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/neon_pink"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvStatActiveAlertsSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Clear"
                        android:textColor="@color/neon_pink"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 3. Resolved Alerts -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_dark_card"
                    android:padding="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resolved Alerts"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvStatResolvedAlerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/neon_green"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvStatResolvedAlertsSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Incidents resolved"
                        android:textColor="@color/neon_green"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 4. Volunteers / Responders -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_dark_card"
                    android:padding="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Responders"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvStatVolunteers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/neon_purple"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvStatVolunteersSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active responders"
                        android:textColor="@color/neon_purple"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </GridLayout>

            <!-- ==============================================
                 QUICK ACTIONS TOOLBAR
            ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBroadcast"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="📢 Broadcast"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/neon_pink"
                    app:cornerRadius="12dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmergencyHelplines"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="📞 Helplines 112"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="#0088FF"
                    app:cornerRadius="12dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- ==============================================
                 LIVE EMERGENCY INCIDENTS HEADER
            ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚠️ Live Emergency Incidents"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIncidentCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Active"
                    android:textColor="@color/neon_pink"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_status_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <!-- Incidents Dynamic Container -->
            <LinearLayout
                android:id="@+id/llIncidentsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <!-- Programmatically populated with incident cards -->
            </LinearLayout>

            <!-- ==============================================
                 USER & ROLE BREAKDOWN
            ============================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 User &amp; Role Breakdown"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_dark_card"
                android:padding="16dp"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <!-- User -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User"
                        android:textColor="@color/neon_pink"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvRoleUserCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Parent -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guardian"
                        android:textColor="@color/neon_cyan"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvRoleParentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Volunteer -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Volunteer"
                        android:textColor="@color/neon_orange"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvRoleVolunteerCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Responder / Admin -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin"
                        android:textColor="@color/neon_purple"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvRoleResponderCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Disclaimer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SafeHer Emergency Control System · 24/7 Monitoring Active"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
