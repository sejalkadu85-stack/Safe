<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnBackAssistance"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_dark_card"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Active Assistance Mission"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageButton
                    android:id="@+id/btnEmergencyCall112"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@color/sos_red"
                    android:src="@drawable/ic_phone_neon"
                    android:contentDescription="Call 112"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- 4-STEP PROGRESSION STEPPER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dark_card"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASSISTANCE STATUS STEPPER"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Step 1: Accepted -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/stepDot1"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="1"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@color/neon_cyan" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accepted"
                            android:textColor="@color/neon_cyan"
                            android:textSize="10sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Step 2: On The Way -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/stepDot2"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="2"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@color/card_background_elevated" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="On the Way"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Step 3: Arrived -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/stepDot3"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="3"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@color/card_background_elevated" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Arrived"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Step 4: Resolved -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/stepDot4"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="4"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@color/card_background_elevated" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resolved"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Victim Telemetry Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dark_card"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvMissionVictimName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Citizen in Distress"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMissionAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Coordinates Logged"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvMissionTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance: ~420m away · ETA: 3 mins · Battery: 94%"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Turn-by-Turn Navigation & Call Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigateMap"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="🗺️ Google Maps"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="#0088FF"
                    app:cornerRadius="12dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallVictim"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="📞 Call User"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/neon_green"
                    app:cornerRadius="12dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- PRIMARY PROGRESSION BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProgressStatus"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🚗 I am On the Way"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/neon_pink"
                app:cornerRadius="14dp"
                android:layout_marginBottom="16dp" />

            <!-- Mark as False Alarm / Cancel Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelAssistance"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Withdraw / Unable to Assist"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
