<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <!-- Top Chat App Bar -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_location_pill">

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-bold"
                android:text="M"
                android:textColor="@color/primary"
                android:textSize="16sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvContactName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:text="Safety Guardian"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/vStatusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_dot_inactive"
                    android:backgroundTint="@color/neon_green" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif"
                    android:text="Real-time Live"
                    android:textColor="@color/neon_green"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnVoiceCall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Call"
            android:padding="7dp"
            android:src="@drawable/ic_phone_neon"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnVideoCall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Video Call"
            android:padding="7dp"
            android:src="@drawable/ic_safety_shield"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Chat Messages ScrollView -->
    <ScrollView
        android:id="@+id/svMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toTopOf="@+id/llQuickBarContainer"
        app:layout_constraintTop_toBottomOf="@+id/llTopBar">

        <LinearLayout
            android:id="@+id/llMessageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Today Divider -->
            <TextView
                android:id="@+id/tvDateHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="12dp"
                android:background="@drawable/bg_dark_card_subtle"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="Today • End-to-End Encrypted"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Quick Message Template Bar (at top of keyboard) -->
    <LinearLayout
        android:id="@+id/llQuickBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/llInputBar">

        <HorizontalScrollView
            android:id="@+id/hsvQuickTemplates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="true"
            android:paddingHorizontal="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llQuickTemplates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Template chips inserted dynamically -->
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/llInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Location Pin Button -->
        <FrameLayout
            android:id="@+id/btnSendLocation"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dark_card_subtle"
            android:contentDescription="Share Location Pin">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/neon_cyan" />
        </FrameLayout>

        <!-- Message Input -->
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_input"
            android:hint="Type a message or tap quick chip..."
            android:paddingHorizontal="16dp"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <!-- Voice Note Button -->
        <FrameLayout
            android:id="@+id/btnVoiceNote"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dark_card_subtle"
            android:contentDescription="Record Voice Message">

            <ImageView
                android:id="@+id/ivMicIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/primary" />
        </FrameLayout>

        <!-- Send Button -->
        <ImageView
            android:id="@+id/btnSendMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_neon_pink_button"
            android:contentDescription="Send"
            android:padding="11dp"
            android:src="@drawable/ic_send_neon"
            app:tint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
