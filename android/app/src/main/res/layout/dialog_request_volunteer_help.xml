<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dark_card">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Request Volunteer Help"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send a direct companion or assistance request"
        android:textColor="@color/neon_pink"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <!-- Type Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assistance Type"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spEmergencyType"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp" />

    <!-- Message / Location notes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notes / Pickup Location Details"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etMessage"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="top|start"
        android:background="@drawable/bg_input_field"
        android:hint="e.g., Waiting near metro exit 2, walking alone..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:padding="12dp"
        android:inputType="textMultiLine" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDialog"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:backgroundTint="@color/card_background"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendRequest"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:text="Send Request 🚀"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
