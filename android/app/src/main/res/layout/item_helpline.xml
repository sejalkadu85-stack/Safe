<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Category Icon Box -->
            <FrameLayout
                android:id="@+id/iconBox"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dark_card"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/ivCategoryIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_phone_neon"
                    app:tint="@color/neon_pink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHelplineName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="National Emergency"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvCategoryBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMERGENCY"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_cyan"
                        android:background="@drawable/bg_status_pill"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />

                    <TextView
                        android:id="@+id/tvTollFreeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24x7 Toll-Free"
                        android:textSize="10sp"
                        android:textColor="@color/neon_green"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Unified emergency response system for Police, Fire, and Ambulance."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/tvPhoneNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="112"
                android:textColor="@color/neon_cyan"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Call Now"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_call"
                app:iconTint="@color/text_primary"
                app:iconSize="16dp"
                app:backgroundTint="@color/neon_green"
                app:cornerRadius="20dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
