<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- Discreet subtle header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Calculator"
            android:textColor="#888888"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnStealthSettings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Settings"
            android:padding="4dp"
            android:src="@drawable/ic_gear_neon"
            app:tint="#444444" />
    </RelativeLayout>

    <!-- Calculator Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvCalcHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#777777"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvCalcDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:fontFamily="sans-serif-light"
            android:singleLine="true"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="48sp" />
    </LinearLayout>

    <!-- Calculator Keypad (Table Layout) -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="24dp"
        android:stretchColumns="*">

        <!-- Row 1: C, ( ), %, / -->
        <TableRow android:layout_marginBottom="10dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnC"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="C"
                android:textColor="#FF5252"
                android:textSize="22sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSilentSosKey"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="±"
                android:textColor="#29B6F6"
                android:textSize="22sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPercent"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="%"
                android:textColor="#29B6F6"
                android:textSize="22sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiv"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="÷"
                android:textColor="#FFB74D"
                android:textSize="24sp"
                app:cornerRadius="34dp" />
        </TableRow>

        <!-- Row 2: 7, 8, 9, * -->
        <TableRow android:layout_marginBottom="10dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn7"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn8"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn9"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMul"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="×"
                android:textColor="#FFB74D"
                android:textSize="24sp"
                app:cornerRadius="34dp" />
        </TableRow>

        <!-- Row 3: 4, 5, 6, - -->
        <TableRow android:layout_marginBottom="10dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn4"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn5"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn6"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSub"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="-"
                android:textColor="#FFB74D"
                android:textSize="26sp"
                app:cornerRadius="34dp" />
        </TableRow>

        <!-- Row 4: 1, 2, 3, + -->
        <TableRow android:layout_marginBottom="10dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="+"
                android:textColor="#FFB74D"
                android:textSize="24sp"
                app:cornerRadius="34dp" />
        </TableRow>

        <!-- Row 5: 0, ., backspace, = -->
        <TableRow>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn0"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDot"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="."
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_height="68dp"
                android:text="⌫"
                android:textColor="#B0BEC5"
                android:textSize="20sp"
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEquals"
                android:layout_height="68dp"
                android:backgroundTint="#FF9100"
                android:text="="
                android:textColor="#000000"
                android:textSize="26sp"
                android:textStyle="bold"
                app:cornerRadius="34dp" />
        </TableRow>
    </TableLayout>

</LinearLayout>
