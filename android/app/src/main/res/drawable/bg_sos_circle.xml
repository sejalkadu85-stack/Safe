<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#FFCDD2">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FF4B4B"
                android:centerColor="#E53935"
                android:endColor="#B71C1C"
                android:type="linear" />
            <stroke
                android:width="6dp"
                android:color="#FF8A80" />
            <size
                android:width="160dp"
                android:height="160dp" />
        </shape>
    </item>
</ripple>
