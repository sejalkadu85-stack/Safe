<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: SafeHer Dark Neon Theme -->
    <style name="Theme.WomenSafety" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.WomenSafety.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowBackground">@color/screen_background</item>
    </style>
</resources>
